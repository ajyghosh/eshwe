[2026-09-12T16:18:14.153Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/eshwesareestudio/rulesets {"name":"projects/eshwesareestudio/rulesets/4a1fae26-4e9d-49b6-a32e-23e5a9d9709f","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function isPrimaryOwner() {\n      return request.auth != null\n        && request.auth.token.email_verified == true\n        && request.auth.token.email == \"ajyghosh@gmail.com\";\n    }\n\n    function isListedOwner() {\n      return request.auth != null\n        && request.auth.token.email_verified == true\n        && exists(/databases/$(database)/documents/ownerAccounts/$(request.auth.token.email));\n    }\n\n    function isOwner() {\n      return isPrimaryOwner() || isListedOwner();\n    }\n\n    match /ownerAccounts/{ownerEmail} {\n      allow read: if isOwner();\n      allow write: if isPrimaryOwner();\n    }\n\n    match /siteContent/{documentId} {\n      allow read: if true;\n      allow write: if isOwner();\n    }\n\n    match /categoryCards/{categoryId} {\n      allow read: if true;\n      allow write: if isOwner();\n    }\n\n    match /productGroups/{groupId} {\n      allow read: if isOwner();\n      allow write: if isOwner();\n    }\n\n    match /productMasterOptions/{optionId} {\n      allow read: if isOwner();\n      allow write: if isOwner();\n    }\n\n    match /customerProfiles/{userId} {\n      allow read, write: if request.auth != null && request.auth.uid == userId;\n    }\n\n    match /checkoutOrders/{orderId} {\n      allow read: if isOwner()\n        || (\n          request.auth != null\n          && resource.data.userId is string\n          && resource.data.userId == request.auth.uid\n        );\n      allow write: if false;\n      match /history/{eventId} { allow read: if isOwner(); allow write: if false; }\n    }\n\n    match /customerMessages/{messageId} {\n      allow create: if request.resource.data.keys().hasOnly([\n        \"email\",\n        \"phone\",\n        \"message\",\n        \"sourcePath\",\n        \"status\",\n        \"createdAt\",\n        \"updatedAt\"\n      ])\n        && request.resource.data.email is string\n        && request.resource.data.email.size() > 4\n        && request.resource.data.email.size() <= 120\n        && request.resource.data.phone is string\n        && request.resource.data.phone.size() > 5\n        && request.resource.data.phone.size() <= 30\n        && request.resource.data.message is string\n        && request.resource.data.message.size() > 0\n        && request.resource.data.message.size() <= 2000\n        && request.resource.data.sourcePath is string\n        && request.resource.data.sourcePath.size() > 0\n        && request.resource.data.sourcePath.size() <= 200\n        && request.resource.data.status == \"new\";\n      allow read, update, delete: if isOwner();\n    }\n\n    match /waitlistEntries/{entryId} {\n      allow create: if request.resource.data.keys().hasOnly([\n        \"productId\",\n        \"productName\",\n        \"productSlug\",\n        \"productSku\",\n        \"productCategory\",\n        \"email\",\n        \"phone\",\n        \"sourcePath\",\n        \"status\",\n        \"createdAt\",\n        \"updatedAt\"\n      ])\n        && request.resource.data.productId is string\n        && request.resource.data.productId.size() > 0\n        && request.resource.data.productId.size() <= 80\n        && request.resource.data.productName is string\n        && request.resource.data.productName.size() > 0\n        && request.resource.data.productName.size() <= 200\n        && request.resource.data.productSlug is string\n        && request.resource.data.productSlug.size() > 0\n        && request.resource.data.productSlug.size() <= 200\n        && request.resource.data.productSku is string\n        && request.resource.data.productSku.size() > 0\n        && request.resource.data.productSku.size() <= 80\n        && request.resource.data.productCategory is string\n        && request.resource.data.productCategory.size() > 0\n        && request.resource.data.productCategory.size() <= 120\n        && request.resource.data.email is string\n        && request.resource.data.email.size() <= 120\n        && request.resource.data.phone is string\n        && request.resource.data.phone.size() <= 30\n        && (request.resource.data.email.size() > 4 || request.resource.data.phone.size() > 5)\n        && request.resource.data.sourcePath is string\n        && request.resource.data.sourcePath.size() > 0\n        && request.resource.data.sourcePath.size() <= 200\n        && request.resource.data.status == \"new\";\n      allow read, update, delete: if isOwner();\n    }\n\n    match /sarees/{sareeId} {\n      allow read: if isOwner() || resource.data.status in [\"active\", \"out_of_stock\"];\n      allow write: if false;\n      match /inventoryHistory/{eventId} { allow read: if isOwner(); allow write: if false; }\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-09-12T16:18:14.041567Z","metadata":{"services":["cloud.firestore"]}}
