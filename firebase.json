{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "out",
    "predeploy": [
      "npm run build:hosting"
    ],
    "ignore": [
      "firebase.json",
      "**/development/**",
      "**/*.hot-update.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Service-Worker-Allowed",
            "value": "/"
          }
        ]
      },
      {
        "source": "**/*.txt",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, must-revalidate"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/checkout/status",
        "function": {
          "functionId": "checkoutStatusUs",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/owner/order",
        "function": {
          "functionId": "ownerOrderActionUs",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/owner/product",
        "function": {
          "functionId": "ownerProductActionUs",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/razorpay/create-order",
        "function": {
          "functionId": "createRazorpayOrderUs",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/razorpay/verify-payment",
        "function": {
          "functionId": "verifyRazorpayPaymentUs",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/razorpay/app-callback",
        "function": {
          "functionId": "razorpayAppCallbackUs",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/razorpay/webhook",
        "function": {
          "functionId": "razorpayWebhookUs",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/customer-auth/send-otp",
        "function": {
          "functionId": "sendCustomerOtpUs",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/customer-auth/verify-otp",
        "function": {
          "functionId": "verifyCustomerOtpUs",
          "region": "us-central1"
        }
      },
      {
        "source": "/app/product/**/*.txt",
        "destination": "/app/product/index.txt"
      },
      {
        "source": "/app/search/**/*.txt",
        "destination": "/app/search/index.txt"
      },
      {
        "source": "/product/**",
        "destination": "/product/index.html"
      },
      {
        "source": "/app/product/**",
        "destination": "/app/product/index.html"
      },
      {
        "source": "/app/search/**",
        "destination": "/app/search/index.html"
      },
      {
        "source": "/shop/search/**",
        "destination": "/shop/index.html"
      },
      {
        "source": "/shop/new-arrivals/**",
        "destination": "/shop/index.html"
      },
      {
        "source": "/shop/featured/**",
        "destination": "/shop/index.html"
      },
      {
        "source": "/shop/category/**",
        "destination": "/shop/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
