rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isPrimaryOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "ajyghosh@gmail.com";
    }

    function isListedOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/ownerAccounts/$(request.auth.token.email));
    }

    function isOwner() {
      return isPrimaryOwner() || isListedOwner();
    }

    match /ownerAccounts/{ownerEmail} {
      allow read: if isOwner();
      allow write: if isPrimaryOwner();
    }

    match /siteContent/{documentId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /categoryCards/{categoryId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /productGroups/{groupId} {
      allow read: if isOwner();
      allow write: if isOwner();
    }

    match /productMasterOptions/{optionId} {
      allow read: if isOwner();
      allow write: if isOwner();
    }

    match /customerProfiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /customerMessages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly([
        "email",
        "phone",
        "message",
        "sourcePath",
        "status",
        "createdAt",
        "updatedAt"
      ])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 4
        && request.resource.data.email.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 5
        && request.resource.data.phone.size() <= 30
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.sourcePath is string
        && request.resource.data.sourcePath.size() > 0
        && request.resource.data.sourcePath.size() <= 200
        && request.resource.data.status == "new";
      allow read, update, delete: if isOwner();
    }

    match /sarees/{sareeId} {
      allow read: if true;
      allow write: if isOwner();
    }
  }
}
